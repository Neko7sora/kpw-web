{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "build:minify": {
      "cache": false
    },
    "check": {},
    "clean:build": {
      "cache": false
    },
    "clean:install": {
      "cache": false
    },
    "clean:turbo": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "fix": {},
    "install:next": {
      "cache": false
    },
    "website-root-tailwild#build": {
      "outputs": [
        "$TURBO_ROOT$/public/**",
        "!$TURBO_ROOT$/public/docs/**",
        "resources/**",
        "assets/css/style.css"
      ]
    },
    "website-docs#build": {
      "outputs": ["$TURBO_ROOT$/public/docs/**"]
    }
  },
  "globalDependencies": [
    "scripts/**",
    "packages/install-hugo/package.json",
    "packages/install-mkdocs/requirements.txt",
    "packages/app-mkdocs-extra/**"
  ]
}

{
  "name": "install-hugo",
  "description": "Install the required environment for hugo.",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:next": "hugo-installer --version otherDependencies.hugo --extended --destination ../../.cache/hugo && shx cp ../../.cache/hugo/hugo* ../../node_modules/.bin/",
    "clean": "run-s clean:*",
    "clean:build": "shx rm -rf ../../.cache/hugo ../../node_modules/.bin/hugo ../../node_modules/.bin/hugo.exe",
    "clean:install": "shx rm -rf node_modules",
    "clean:turbo": "shx rm -rf .turbo"
  },
  "dependencies": {
    "shx": "^0.4.0",
    "@neko7sora/hugo-installer": "^4.0.1-fork"
  },
  "otherDependencies": {
    "hugo": "0.169.0"
  }
}

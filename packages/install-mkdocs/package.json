{
  "name": "install-mkdocs",
  "description": "Install the required environment for mkdocs.",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:next": "node ../../scripts/python.mjs --setup -m pip install --upgrade -r requirements.txt --use-pep517",
    "clean": "run-s clean:*",
    "clean:install": "node ../../scripts/python.mjs -m pip uninstall -y -r requirements.txt",
    "clean:turbo": "shx rm -rf .turbo"
  }
}
